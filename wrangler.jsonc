{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "marquee",
	"compatibility_date": "2026-10-29",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"ratelimits": [
		{
			"name": "PUBLIC_SHARE_LIMITER",
			"namespace_id": "991001",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			"name": "APP_RATE_LIMITER",
			"namespace_id": "991002",
			"simple": {
				"limit": 300,
				"period": 60
			}
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "marquee",
			"database_id": "a54537ab-09e0-48d7-ac8f-46c33cf631a2",
			"migrations_dir": "drizzle",
			"preview_database_id": "72ed3d6e-b0a2-46cd-ad5e-00ec51f928a6"
		}
	],
	"triggers": {
		"crons": ["0 * * * *", "0 6 * * *"]
	},
	"queues": {
		"producers": [
			{
				"binding": "MEDIA_REFRESH_QUEUE",
				"queue": "marquee-media-refresh"
			}
		],
		"consumers": [
			{
				"queue": "marquee-media-refresh",
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				"max_retries": 10,
				"max_concurrency": 2,
				"dead_letter_queue": "marquee-media-refresh-dlq"
			}
		]
	},
	"observability": {
		"enabled": true,
		"issues": {
			"enabled": true
		},
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"previews": {
		"ratelimits": [
			{
				"name": "PUBLIC_SHARE_LIMITER",
				"namespace_id": "991001",
				"simple": {
					"limit": 120,
					"period": 60
				}
			},
			{
				"name": "APP_RATE_LIMITER",
				"namespace_id": "991002",
				"simple": {
					"limit": 300,
					"period": 60
				}
			}
		],
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "marquee-preview",
				"database_id": "72ed3d6e-b0a2-46cd-ad5e-00ec51f928a6",
				"migrations_dir": "drizzle"
			}
		],
		"vars": {
			"PREVIEW_NOINDEX": "1"
		},
		"queues": {
			"producers": [
				{
					"binding": "MEDIA_REFRESH_QUEUE",
					"queue": "marquee-preview-media-refresh"
				}
			]
		},
		"observability": {
			"enabled": true,
			"issues": {
				"enabled": true
			},
			"head_sampling_rate": 1,
			"logs": {
				"enabled": true,
				"head_sampling_rate": 1,
				"persist": true,
				"invocation_logs": true
			},
			"traces": {
				"enabled": true,
				"persist": true,
				"head_sampling_rate": 1
			}
		}
	},
	"upload_source_maps": true
}
