{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "marquee",
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "marquee",
			"database_id": "a54537ab-09e0-48d7-ac8f-46c33cf631a2",
			"migrations_dir": "drizzle"
		}
	],
	"triggers": {
		// Two schedules (append-cron.mjs routes each to its own endpoint): the hourly notifications
		// digest (so 9AM lands in every timezone) and the daily maintenance sweep at 06:00 UTC.
		"crons": ["0 * * * *", "0 6 * * *"]
	},
	"queues": {
		"producers": [
			{
				"binding": "MEDIA_REFRESH_QUEUE",
				"queue": "marquee-media-refresh"
			}
		],
		"consumers": [
			{
				"queue": "marquee-media-refresh",
				// Titles are refreshed one at a time, but each costs one TMDB detail call plus one
				// *concurrent* call per season (refreshMedia fans seasons out with Promise.all), so a
				// long-running series alone is dozens of requests. Small batches keep a single
				// invocation well inside the Worker's CPU/wall-time budget.
				"max_batch_size": 10,
				"max_batch_timeout": 30,
				// Backstop only: refresh-consumer.ts gives up (acks) after MAX_DELIVERY_ATTEMPTS (5),
				// which must stay below this so *that* decision is what ends retries, not this one.
				// The gap is wide because a batch-level failure retries every message, inflating each
				// one's attempt count without it having been tried on its own merits.
				"max_retries": 10,
				// Conservative: the previous cron refresh was effectively single-flight. A full-backlog
				// drain now concentrates requests into one nightly window instead of spreading across
				// nights, so concurrency starts low pending real TMDB headroom data. Note the real
				// peak is this times the season count of the widest title in flight, not this alone.
				"max_concurrency": 2,
				"dead_letter_queue": "marquee-media-refresh-dlq"
			}
		]
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"env": {
		"preview": {
			"name": "marquee-preview",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "marquee-preview",
					"database_id": "72ed3d6e-b0a2-46cd-ad5e-00ec51f928a6",
					"migrations_dir": "drizzle"
				}
			],
			"triggers": {
				// Two schedules (see prod triggers above): hourly notifications + daily 06:00 maintenance.
				"crons": ["0 * * * *", "0 6 * * *"]
			},
			"queues": {
				"producers": [
					{
						"binding": "MEDIA_REFRESH_QUEUE",
						"queue": "marquee-preview-media-refresh"
					}
				],
				"consumers": [
					{
						// Mirrors the prod consumer above — see the rationale for each value there.
						// `max_retries` must stay above refresh-consumer.ts's MAX_DELIVERY_ATTEMPTS.
						"queue": "marquee-preview-media-refresh",
						"max_batch_size": 10,
						"max_batch_timeout": 30,
						"max_retries": 10,
						"max_concurrency": 2,
						"dead_letter_queue": "marquee-preview-media-refresh-dlq"
					}
				]
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"persist": true,
					"invocation_logs": true
				},
				"traces": {
					"enabled": true,
					"persist": true,
					"head_sampling_rate": 1
				}
			}
		}
	}
}
