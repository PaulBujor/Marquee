{
	"name": "marquee",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.13.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build && node scripts/append-cron.mjs",
		"preview": "wrangler dev",
		"deploy": "wrangler d1 migrations apply marquee --remote && wrangler deploy",
		"deploy:preview": "wrangler d1 migrations apply marquee-preview --remote --env preview && wrangler deploy --env preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types",
		"gen:icons": "node scripts/generate-icons.mjs",
		"test": "svelte-kit sync && vitest run",
		"test:watch": "svelte-kit sync && vitest",
		"test:coverage": "svelte-kit sync && vitest run --coverage",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply marquee --local",
		"db:migrate:remote": "wrangler d1 migrations apply marquee --remote",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.35.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26",
		"@types/nodemailer": "^8.0.1",
		"@vitest/coverage-v8": "^4.1.11",
		"better-sqlite3": "^13.0.3",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.11.0",
		"nodemailer": "^9.0.6",
		"png-to-ico": "^3.0.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.0"
	},
	"dependencies": {
		"@pushforge/builder": "^2.0.5",
		"bits-ui": "^2.19.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"idb": "^8.0.3",
		"resend": "^6.24.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"uuid": "^14.0.2",
		"zod": "^4.4.3"
	}
}
