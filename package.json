{
	"name": "marquee",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.13.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @marquee/web dev",
		"build": "pnpm --filter @marquee/web build",
		"preview": "pnpm --filter @marquee/web preview",
		"deploy": "pnpm --filter @marquee/web deploy",
		"deploy:preview": "pnpm --filter @marquee/web deploy:preview",
		"check": "pnpm --filter @marquee/web check",
		"check:watch": "pnpm --filter @marquee/web check:watch",
		"test": "pnpm --filter @marquee/web test",
		"test:watch": "pnpm --filter @marquee/web test:watch",
		"test:coverage": "pnpm --filter @marquee/web test:coverage",
		"lint": "pnpm --filter @marquee/web lint",
		"format": "pnpm --filter @marquee/web format",
		"gen": "pnpm --filter @marquee/web gen",
		"gen:icons": "pnpm --filter @marquee/web gen:icons",
		"db:generate": "pnpm --filter @marquee/web db:generate",
		"db:migrate:local": "pnpm --filter @marquee/web db:migrate:local",
		"db:migrate:remote": "pnpm --filter @marquee/web db:migrate:remote",
		"db:studio": "pnpm --filter @marquee/web db:studio"
	}
}
