{
	// Standalone cron Worker (MRQ-39) — deployed separately from the SvelteKit app worker
	// (`wrangler.jsonc`) because adapter-cloudflare can't host a `scheduled` handler. Shares the
	// same D1 database and `src/lib/server/*` code. Deploy: `pnpm cron:deploy`; the TMDB key is set
	// with `wrangler secret put TMDB_API_KEY -c wrangler.cron.jsonc`.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "marquee-cron",
	"main": "src/cron/index.ts",
	"compatibility_date": "2026-07-16",
	// Required for D1 + node built-ins used by the shared server code.
	"compatibility_flags": ["nodejs_compat"],
	// Resolve SvelteKit's `$lib` alias for the wrangler/esbuild bundle (there's no Vite here).
	"alias": {
		"$lib": "./src/lib"
	},
	// 06:00 UTC daily — after most timezones' prime-time so newly-aired episodes are reflected.
	"triggers": {
		"crons": ["0 6 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "marquee",
			"database_id": "a54537ab-09e0-48d7-ac8f-46c33cf631a2",
			"migrations_dir": "drizzle"
		}
	],
	"observability": {
		"enabled": true
	}
}
