{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["./worker-configuration.d.ts"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true
	},
	"include": ["src", "vitest.config.ts"]
}
