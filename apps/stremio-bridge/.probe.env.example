# Tooling-only secrets (copy to .probe.env). Gitignored, and read with `--env-file`:
#
#   node --env-file=.probe.env scripts/probe-stremio.mjs
#
# NOT `.dev.vars`: that file feeds `wrangler types`, so a key there becomes a required member
# of the Worker's Env and breaks `pnpm check`.

# Stremio auth key of a *test* account (it is account-wide, so it is the account).
# web.stremio.com in a private window → DevTools → Application → Local Storage → authKey
STREMIO_AUTH_KEY=
